{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=interntrack_db;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "Issuer": "InternTrackApi",
    "Audience": "InternTrackClient",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "AppConfig": {
    "FrontendBaseUrl": "http://localhost:5173"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "Defenses": {
    "PassingGrade": 10,
    "MaxAttempts": 2,
    "TutorWeight": 0.25,
    "RequireTutorEvaluation": false,
    "EarliestDaysBeforeEnd": 30,
    "LatestDaysAfterEnd": 90,
    "RetakeLatestDaysAfterEnd": 180,
    "MinValidatedReportRatio": 0.5
  },
  "Database": {
    "AutoMigrate": false,
    "SeedDemoData": false
  },
  "Smtp": {
    "Enabled": false
  },
  "Auth": {
    "CrossSiteRefreshCookie": false
  },
  "ReverseProxy": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Gemini": {
    "Model": "gemini-2.5-flash"
  }
}
