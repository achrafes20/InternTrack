# Copiez ce fichier en `.env` avant `docker compose up -d`.
# Toutes les valeurs ci-dessous sont des exemples de DÉVELOPPEMENT.
# En production, utilisez un gestionnaire de secrets et ne committez jamais `.env`.

# Mot de passe PostgreSQL
POSTGRES_PASSWORD=interntrack_password

# Port de la base sur la machine hôte (pour DBeaver, pgAdmin…). 5433 évite le conflit
# avec un PostgreSQL déjà installé sur 5432. L'API n'en dépend pas.
POSTGRES_HOST_PORT=5433

# Clé de signature JWT (32 caractères minimum, obligatoire)
JWT_SECRET=InternTrack-Dev-Only-Secret-Key-Change-Me-In-Production-2026-ENSA-PFE!

# Environnement ASP.NET Core (Development active Swagger et les données de démo)
ASPNETCORE_ENVIRONMENT=Development

# Injecte le jeu de données de démonstration au démarrage (false en production)
SEED_DEMO_DATA=true

# Stockage des fichiers déposés : Local (volume Docker) ou AzureBlob.
# Test local d'Azure Blob : STORAGE_PROVIDER=AzureBlob puis docker compose --profile azure up -d
# (la chaîne par défaut pointe sur l'émulateur Azurite). En production : identité managée (Storage__AzureBlob__AccountUrl).
STORAGE_PROVIDER=Local
# AZURE_BLOB_CONNECTION_STRING=

# Antivirus ClamAV : ANTIVIRUS_ENABLED=true puis docker compose --profile antivirus up -d
# (si activé et injoignable, les dépôts sont refusés).
ANTIVIRUS_ENABLED=false
